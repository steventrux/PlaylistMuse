# PlaylistMuse providers and credentials are configured from the web interface.
# This optional value controls the persistent data directory for local runs.
PLAYLISTMUSE_DATA_DIR=data

# Optional Last.fm discovery for both prompt-based and seed-based playlists.
# Create an API account at https://www.last.fm/api/account/create and paste its API key here,
# or save the key later from the Last.fm settings panel in PlaylistMuse.
PLAYLISTMUSE_LASTFM_API_KEY=

# Optional Last.fm request timeout in seconds (default: 4, accepted range: 1-15).
# PLAYLISTMUSE_LASTFM_TIMEOUT_SECONDS=4
